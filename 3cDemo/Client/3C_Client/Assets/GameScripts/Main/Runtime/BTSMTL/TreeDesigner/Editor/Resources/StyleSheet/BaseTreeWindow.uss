#graph-workspace {
    flex-grow: 1;
    flex-direction: column;
}

#workspace-horizontal,
#workspace-content-vertical,
#workspace-main-horizontal,
#workspace-graph {
    flex-grow: 1;
}

.workspace-toolbar {
    height: 28px;
    min-height: 28px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(42, 42, 42);
    border-bottom-width: 1px;
    border-bottom-color: rgb(22, 22, 22);
}

#workspace-toolbar-content {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.workspace-region-toggle {
    min-width: 58px;
    height: 22px;
    margin-left: 2px;
    margin-right: 0;
    margin-top: 3px;
    margin-bottom: 3px;
    padding-left: 6px;
    padding-right: 6px;
    color: rgb(150, 150, 150);
}

.workspace-region-toggle-expanded {
    color: rgb(235, 235, 235);
    background-color: rgb(61, 61, 61);
}

.workspace-region {
    flex-direction: column;
    background-color: rgb(35, 35, 35);
}

.workspace-side-region {
    min-width: 220px;
}

.workspace-bottom-region {
    min-height: 120px;
}

.workspace-region-title {
    height: 24px;
    min-height: 24px;
    padding-left: 8px;
    padding-top: 4px;
    color: rgb(205, 205, 205);
    background-color: rgb(45, 45, 45);
    border-bottom-width: 1px;
    border-bottom-color: rgb(24, 24, 24);
    -unity-font-style: bold;
}

.workspace-region-content {
    flex-grow: 1;
    overflow: hidden;
}

.workspace-empty-state {
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 8px;
    white-space: normal;
    color: rgb(145, 145, 145);
}

#tree-navigation-toolbar {
    height: 26px;
    min-height: 26px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(35, 35, 35);
    border-bottom-width: 1px;
    border-bottom-color: rgb(22, 22, 22);
}

#tree-navigation-back-button {
    width: 24px;
    min-width: 24px;
    height: 22px;
    margin-left: 3px;
    margin-right: 3px;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 1px;
    -unity-text-align: middle-center;
}

#tree-navigation-breadcrumb {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.tree-navigation-segment {
    height: 22px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: rgb(180, 180, 180);
    -unity-text-align: middle-center;
}

.tree-navigation-current-segment {
    height: 22px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 3px;
    padding-bottom: 0;
    color: rgb(230, 230, 230);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.tree-navigation-separator {
    height: 22px;
    margin-left: 1px;
    margin-right: 1px;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 3px;
    padding-bottom: 0;
    color: rgb(105, 105, 105);
    -unity-text-align: middle-center;
}

#tree-view {
    flex-grow: 1;
}

#tree-title {
    display: none;
}

#tree-inspector {
    flex-grow: 1;
}

#unity-dragline-anchor {
    width: 2px;
    background-color: rgb(25, 25, 25);
}

#node-description {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    position: absolute;
    -unity-font-style: bold;
    font-size: 14px;
    white-space: normal;
    max-width: 300px;
    right: 0;
}

#nodeSearchContainer {
    position: absolute;
    bottom: 0;
    padding-left: 5px;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 3px;
}
