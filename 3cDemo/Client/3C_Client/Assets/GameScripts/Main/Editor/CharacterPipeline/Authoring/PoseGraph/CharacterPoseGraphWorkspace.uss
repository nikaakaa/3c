.pose-workspace {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background-color: rgb(28, 28, 28);
}

#pose-main-horizontal,
#pose-left-vertical,
#pose-content-horizontal,
#pose-graph {
    flex-grow: 1;
}

.pose-toolbar {
    flex-shrink: 0;
    flex-direction: column;
    padding: 6px;
    background-color: rgb(38, 38, 38);
}
.pose-document-title {
    white-space: normal;
    -unity-font-style: bold;
    margin-bottom: 6px;
}
.pose-toolbar-content {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}
.pose-toolbar-content > .unity-base-field {
    width: 100%;
    min-width: 0;
}
.pose-authoring-status {
    white-space: normal;
    margin-top: 4px;
    color: rgb(162, 162, 162);
}
.pose-panel-tabs {
    flex-direction: row;
    flex-shrink: 0;
    height: 28px;
}
.pose-panel-tabs > Button {
    flex-grow: 1;
}
.pose-panel-body,
.pose-panel-page {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
}
.pose-panel-page > * {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
}

.pose-region {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(32, 32, 32);
}

.pose-preview-region {
    min-height: 260px;
}

.pose-details-region {
    min-width: 280px;
}

.pose-region-title {
    height: 24px;
    min-height: 24px;
    padding-left: 8px;
    padding-top: 4px;
    color: rgb(205, 205, 205);
    background-color: rgb(45, 45, 45);
    border-bottom-width: 1px;
    border-bottom-color: rgb(20, 20, 20);
    -unity-font-style: bold;
}

.pose-region-content,
.pose-region-content > * {
    flex-grow: 1;
}

#tree-view,
#pose-details,
#linked-pose-details,
.pose-read-only-panel {
    flex-grow: 1;
}

.pose-selection-tuning {
    max-height: 42%;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgb(20, 20, 20);
}

.pose-preview-status,
.pose-tuning-status {
    margin: 4px;
    white-space: normal;
    color: rgb(175, 175, 180);
}

.pose-tuning-row {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
}

.pose-tuning-authoring-field {
    flex-grow: 1;
    min-width: 150px;
}

.pose-tuning-applied-value {
    width: 74px;
    min-width: 74px;
    margin-left: 4px;
    color: rgb(190, 190, 195);
    -unity-text-align: middle-right;
}

.pose-tuning-apply-status {
    width: 92px;
    min-width: 92px;
    margin-left: 5px;
    color: rgb(145, 165, 190);
    -unity-text-align: middle-right;
}

.pose-applied-row {
    flex-direction: row;
    margin-top: 2px;
    margin-bottom: 2px;
}

.pose-applied-label {
    min-width: 130px;
    -unity-font-style: bold;
}

.pose-applied-value {
    flex-grow: 1;
    white-space: normal;
}

#unity-dragline-anchor {
    width: 2px;
    background-color: rgb(20, 20, 20);
}

.pose-runtime-active {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 196, 52);
    border-right-color: rgb(255, 196, 52);
    border-top-color: rgb(255, 196, 52);
    border-bottom-color: rgb(255, 196, 52);
}

.pose-validation-error {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(225, 66, 60);
    border-right-color: rgb(225, 66, 60);
    border-top-color: rgb(225, 66, 60);
    border-bottom-color: rgb(225, 66, 60);
}

.pose-target-controls {
    width: 100%;
    min-width: 0;
    flex-shrink: 1;
}
.pose-target-controls .unity-base-field__label {
    width: 90px;
    min-width: 90px;
}
