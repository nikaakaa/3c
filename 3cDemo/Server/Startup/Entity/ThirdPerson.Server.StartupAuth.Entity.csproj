<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ThirdPerson.Server.StartupAuth.Entity</AssemblyName>
    <RootNamespace>Fantasy</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Fantasy-Net" Version="2026.0.1020" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\Gate\Entity\Generate\NetworkProtocol\OuterMessage.cs" Link="Generate\NetworkProtocol\OuterMessage.cs" />
    <Compile Include="..\..\Gate\Entity\Generate\NetworkProtocol\OuterOpcode.cs" Link="Generate\NetworkProtocol\OuterOpcode.cs" />
  </ItemGroup>
  <Target Name="ExcludeStartupAuthoringConfigurationFromOutput" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Update="$(ProjectDir)Fantasy.config" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
      <None Update="$(ProjectDir)Fantasy.xsd" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    </ItemGroup>
  </Target>
</Project>
