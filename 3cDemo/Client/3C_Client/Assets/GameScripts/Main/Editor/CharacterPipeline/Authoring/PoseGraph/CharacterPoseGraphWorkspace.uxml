<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="pose-workspace" class="pose-workspace">
        <ui:VisualElement name="pose-toolbar" class="pose-toolbar">
            <ui:Label name="pose-document-title" class="pose-document-title" />
            <ui:VisualElement name="pose-toolbar-content" class="pose-toolbar-content" />
            <ui:Label name="pose-authoring-status" class="pose-authoring-status" />
        </ui:VisualElement>
        <ui:VisualElement name="pose-panel-tabs" class="pose-panel-tabs" />
        <ui:VisualElement name="pose-panel-body" class="pose-panel-body">
            <ui:VisualElement name="pose-navigator-content" class="pose-panel-page" />
            <ui:ScrollView name="pose-details-content" class="pose-panel-page" />
            <ui:VisualElement name="pose-preview-content" class="pose-panel-page" />
        </ui:VisualElement>
        <ui:VisualElement name="pose-graph-content" style="display: none;" />
    </ui:VisualElement>
</ui:UXML>
