<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>ThirdPersonSimulation.DotRecast</AssemblyName>
    <RootNamespace>ThirdPersonSimulation.DotRecast</RootNamespace>
    <SimulationSourceRoot>$(MSBuildThisFileDirectory)..\..\..\3cDemo\Client\3C_Client\Assets\GameScripts\Main\Runtime\Simulation\DotRecast</SimulationSourceRoot>
    <DotRecastSourceRoot>$(MSBuildThisFileDirectory)..\..\..\3cDemo\Client\3C_Client\Packages\com.thirdperson.dotrecast\Runtime</DotRecastSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SimulationSourceRoot)\**\*.cs" LinkBase="Source" />
    <Compile Include="$(DotRecastSourceRoot)\DotRecast.Core\**\*.cs" LinkBase="DotRecast.Core" />
    <Compile Include="$(DotRecastSourceRoot)\DotRecast.Detour\**\*.cs" LinkBase="DotRecast.Detour" />
    <ProjectReference Include="..\ThirdPersonSimulation.Core\ThirdPersonSimulation.Core.csproj" />
    <ProjectReference Include="..\ThirdPersonSimulation.Float32\ThirdPersonSimulation.Float32.csproj" />
  </ItemGroup>
</Project>
