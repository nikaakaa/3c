.timelineTrack {
    width: 100%;
    height: 30px;
    background-color: rgba(255, 255, 255, 0.06);
    flex-direction: row;
    margin-top: 5px;
    margin-bottom: 5px;
    position: absolute;
}

.timelineTrack.selected {
    background-color: rgba(68, 192, 255, 0.29);
}

.drop-area {
    flex-grow: 1;
}

.drop-area--dropping {
    background-color: rgba(68, 192, 255, 0.18);
}

.timelineTrackHandle {
    height: 30px;
    background-color: rgb(56, 56, 56);
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-width: 5px;
    border-left-color: rgb(127, 253, 228);
    margin-top: 5px;
    margin-bottom: 5px;
    margin-right: 0;
    position: absolute;
    right: 0;
    left: 20px;
    flex-direction: row;
}

.selected.timelineTrackHandle {
    background-color: rgba(68, 192, 255, 0.29);
}

#name-field {
    flex-grow: 1;
    margin-top: 5px;
    margin-bottom: 5px;
    right: 30px;
    left: 0;
    position: absolute;
    top: 0;
    bottom: 0;
    margin-left: 28px;
}

#delete-track-button {
    width: 22px;
    height: 20px;
    position: absolute;
    right: 3px;
    top: 5px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

#icon {
    width: 20px;
    height: 20px;
    margin-top: 5px;
    margin-left: 5px;
}
