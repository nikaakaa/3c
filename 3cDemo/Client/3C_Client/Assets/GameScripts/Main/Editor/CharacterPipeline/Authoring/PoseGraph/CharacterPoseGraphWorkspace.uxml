<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="pose-workspace" class="pose-workspace" style="background-color: rgb(42, 42, 42); flex-grow: 1;">
        <ui:VisualElement name="pose-toolbar" class="pose-toolbar">
            <ui:Label name="pose-document-title" class="pose-document-title" />
            <ui:VisualElement name="pose-toolbar-content" class="pose-toolbar-content" />
            <ui:Label name="pose-authoring-status" class="pose-authoring-status" />
        </ui:VisualElement>
        <ui:VisualElement name="pose-navigation-toolbar" class="pose-navigation-toolbar">
            <ui:Button name="pose-navigation-back-button" text="返回" />
            <ui:VisualElement name="pose-navigation-breadcrumb" class="pose-navigation-breadcrumb" />
        </ui:VisualElement>
        <ui:Foldout text="图与状态机" value="true">
            <ui:VisualElement name="pose-navigator-content" style="height: 170px;" />
        </ui:Foldout>
        <ui:VisualElement name="pose-graph-content" style="height: 0;" />
        <ui:ScrollView name="pose-details-content" style="flex-grow: 1; min-height: 180px;" />
        <ui:Foldout text="运行观察" value="false">
            <ui:VisualElement name="pose-preview-content" style="height: 300px;" />
        </ui:Foldout>
    </ui:VisualElement>
</ui:UXML>
